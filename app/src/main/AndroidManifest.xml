<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：车机热点（无外网）+ AirPlay/CarLife 回环 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- CHANGE_NETWORK_STATE：requestNetwork（含 WifiNetworkSpecifier 与「取当前 WiFi 句柄」）
         在 Android 11+ 上要求它或 WRITE_SETTINGS，否则直接抛
         SecurityException: was not granted either of these permissions:
         android.permission.CHANGE_NETWORK_STATE,android.permission.WRITE_SETTINGS
         （2026-10-23 现场：连车机热点因此永远失败，而且系统连确认框都不弹）。普通权限，安装即授予。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- 位置权限：Android 12/12L 的 WifiNetworkSpecifier 兜底路径仍需要（manifest 必须成对声明） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 蓝牙：iAP2 RFCOMM + 上车 ACL 广播唤醒（秒连链路的第一环）。
         BLUETOOTH_SCAN 标 neverForLocation：本项目只用 ACL 广播，不用扫描结果推断位置，
         声明后 Android 12/12L 不再因蓝牙索要定位权限。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- 服务与唤醒 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 语音助手要供麦（AudioRecord）：Android 14+ 后台录音必须声明 microphone 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 语音助手（2026-10-24 起）：CarLife 的语音识别要求「车机」侧提供麦克风数据
         （VR 通道 VR_MIC_DATA 0x00058001）。本机 HU 就用手机自己的麦克风采，
         经 nativeSendMic 注入；除此之外不采集任何音频。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="true" />

    <!-- Android 11+ 包可见性：探测 Shizuku 服务端 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- CarLife 系 app：Android 11+ 的包可见性限制会让 getPackageInfo 误报「未安装」
             （2026-10-26 00:34 现场：com.baidu.carlife.xiaomi 明明在 pm list 里，
             我们却判成未安装，唤醒一路退回 com.miui.carlink）。 -->
        <package android:name="com.baidu.carlife" />
        <package android:name="com.baidu.carlife.xiaomi" />
        <package android:name="com.miui.carlink" />
        <package android:name="com.xiaomi.carlink" />
        <package android:name="com.hihonor.carwith" />
        <intent>
            <action android:name="com.baidu.carlife.Action.StartWireless" />
        </intent>
    </queries>

    <application
        android:name=".HyperCarApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperCar">

        <!-- Shizuku binder 接收器（缺它 Shizuku 无法初始化，isReady 恒 false） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 秒连链路：上车（车机蓝牙 ACL 连上）冷启动进程 → 前台服务 → 全自动协商 -->
                <!-- 投屏验证页：由 CastDisplay 启动到 CarLife 提供的虚显上 -->
<service
            android:name=".autowake.HyperCarService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />

        <!-- ACL 广播在隐式广播例外清单内，清单静态注册可拉起被杀进程 -->
        <!-- 调试：adb 广播触发 CarLife 投屏 AIDL 探测（结果写 files/cast_probe.txt） -->
                <!-- CarLife 的投屏宿主（ICarLifeCastManager 实现）：CarLife 会 bindService 到这里，
             所以必须 exported；不加 intent-filter，靠显式组件绑定。 -->
        <service
            android:name=".carlife.CastHostService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />
<receiver
            android:name=".session.DebugProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.hypercar.PROBE_CAST" />
                <action android:name="io.github.hypercar.PROBE_CARLIFE_ONLY" />
                <action android:name="io.github.hypercar.PROBE_RESET_RES" />
                <action android:name="io.github.hypercar.PROBE_CONNECT" />
                <action android:name="io.github.hypercar.PROBE_EXPERIMENT" />
                <action android:name="io.github.hypercar.PROBE_DISCONNECT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".autowake.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

